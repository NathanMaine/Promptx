# Copy to .env and fill in. .env is gitignored.
#
# Nothing here is required if you already use OpenRouter through OpenCode —
# promptx falls back to ~/.local/share/opencode/auth.json automatically.

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# --- optional: DeepSeek direct (server.py only) ---
# Only needed for the deepseek-v4-flash option in the hosted picker. That
# option talks to api.deepseek.com directly — billing and rate limits stay
# separate from OpenRouter on purpose.
DEEPSEEK_API_KEY=

# Which model rewrites your request. Cheap and literal beats smart and chatty.
# See docs/models.md.
PROMPTX_MODEL=google/gemini-2.5-flash-lite

# --- local model options (the "Spark (local · …)" entries in the picker) ---
# Two local engines are wired in. Both are free and never leave your network;
# the hosted UI lets you pick per request.
#
# Ollama — always loaded, the reliable fallback ("Spark (local · Ollama)"):
PROMPTX_SPARK_URL=http://10.0.4.93:11434/v1/chat/completions
PROMPTX_SPARK_MODEL=qwen3.6-uncensored:latest
#
# vLLM — quicker, but serves ONE model at a time ("Spark (local · vLLM)").
# PROMPTX_SPARK_VLLM_MODEL must match whatever is currently loaded, or the
# call fails — check with:  curl -s http://<spark>:8000/v1/models
PROMPTX_SPARK_VLLM_URL=http://10.0.4.93:8000/v1/chat/completions
PROMPTX_SPARK_VLLM_MODEL=sakamakismile/KAT-Coder-V2.5-Dev-NVFP4
#
# main.py and web.py (the local-machine tools) read the same endpoints under
# the LOCAL_* names:
PROMPTX_LOCAL_URL=http://10.0.4.93:11434/v1/chat/completions
PROMPTX_LOCAL_MODEL=qwen3.6-uncensored:latest

# --- server.py only ---
# Where server.py looks for this file. Port and host are CLI flags, not env
# vars:  python3 server.py --port 7331 --host 0.0.0.0
PROMPTX_ENV=/volume1/Projects/promptx/.env
